build/
Vendor/src/
Vendor/TorrlyEngine.xcframework/
build-engine.log

# Xcode project is generated from project.yml (`xcodegen generate`); it also holds your signing team
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcresult/
*.xcarchive/
*.ipa
*.dSYM/
*.dSYM.zip

# Swift Package Manager (Package.resolved stays committed to pin dependency versions)
.build/
.swiftpm/

# Signing material and secrets: never commit
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.p8
.env
.env.*
Local.xcconfig
*.local.xcconfig

# Local working files: saved web pages, one-off scripts and notes (not used by the app or the build)
sites/
add_mirrors*.py
PHASE_*_HANDOFF.md
*.log

# Python caches
__pycache__/
*.pyc

# Editors and OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
